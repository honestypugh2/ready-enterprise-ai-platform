# ---------------------------------------------------------------------------
# ready-enterprise-ai-platform — local configuration template
#
# Copy to `.env` and edit. `.env` is gitignored and must never be committed.
#
# LOCAL MOCK MODE IS THE DEFAULT AND REQUIRES NONE OF THESE VALUES.
# Every setting below is optional. With an empty `.env` — or no `.env` at all —
# the platform runs entirely offline with no Azure subscription, no credential
# and no network access.
#
# There are no secrets in this file and there must never be. Azure and
# production modes authenticate with managed identity; the only supported way
# to supply a secret is Key Vault, resolved at runtime by that identity.
# ---------------------------------------------------------------------------

# --- execution mode --------------------------------------------------------
# local_mock  : no cloud dependency of any kind (default, enforced)
# azure_dev   : opt-in per plane; requires `az login` or a managed identity
# production  : full landing zone; refuses to start without observability,
#               retrieval and reasoning endpoints configured
REAP_MODE=local_mock
REAP_ENVIRONMENT=local
REAP_WORKLOAD_ID=manufacturing-quality
REAP_TENANT_LABEL=demo-tenant

# --- specialized model plane ----------------------------------------------
# mock : deterministic, hash-seeded, no weights (default)
# onnx : a local ONNX graph YOU supply; this repo ships and downloads none
# aml  : an Azure Machine Learning managed online endpoint
REAP_DETECTOR_PROVIDER=mock
REAP_DETECTOR_MODEL_NAME=surface-defect-detector
REAP_DETECTOR_MODEL_VERSION=0.3.0-demo
REAP_DETECTOR_DECISION_THRESHOLD=0.62
REAP_DETECTOR_TIMEOUT_MS=2000
REAP_DETECTOR_MAX_ATTEMPTS=2
# REAP_DETECTOR_ONNX_MODEL_PATH=/absolute/path/to/model.onnx
# REAP_DETECTOR_AML_ENDPOINT_URL=https://<endpoint>.<region>.inference.ml.azure.com/score
# REAP_DETECTOR_AML_DEPLOYMENT_NAME=blue

# --- retrieval plane -------------------------------------------------------
# local        : file-backed corpus in data/knowledge (default)
# azure_search : Azure AI Search with query-time entitlement filters
REAP_RETRIEVAL_PROVIDER=local
REAP_RETRIEVAL_INDEX_NAME=manufacturing-knowledge
REAP_RETRIEVAL_TOP_K=5
# REAP_RETRIEVAL_SEARCH_ENDPOINT=https://<service>.search.windows.net
# REAP_RETRIEVAL_SEMANTIC_CONFIGURATION=default

# --- reasoning plane -------------------------------------------------------
# mock         : deterministic, grounded, offline (default)
# foundry      : a Microsoft Foundry model deployment
# model_router : Foundry Model Router, where the deployment supports it
REAP_REASONING_PROVIDER=mock
REAP_REASONING_MAX_OUTPUT_TOKENS=800
REAP_REASONING_TEMPERATURE=0.0
REAP_REASONING_TIMEOUT_MS=20000
# REAP_REASONING_ENDPOINT=https://<resource>.openai.azure.com
# REAP_REASONING_SMALL_MODEL_DEPLOYMENT=gpt-4o-mini
# REAP_REASONING_FRONTIER_MODEL_DEPLOYMENT=gpt-4o
# REAP_REASONING_API_VERSION=2024-10-21

# --- enterprise action plane ----------------------------------------------
# mock_erp | mock_servicenow | mock_d365 | http
REAP_CONNECTOR_PROVIDER=mock_erp
# Dry run is TRUE by default and is enforced in local mode. Setting it to false
# outside local mode is a deliberate act: it permits real writes.
REAP_CONNECTOR_DRY_RUN=true
REAP_CONNECTOR_TIMEOUT_MS=10000
REAP_CONNECTOR_MAX_ATTEMPTS=3
# REAP_CONNECTOR_BASE_URL=https://<system-of-record>/api

# --- governance ------------------------------------------------------------
REAP_GOVERNANCE_APPROVAL_EXPIRY_HOURS=8
REAP_GOVERNANCE_MAX_WORKFLOW_STEPS=24
REAP_GOVERNANCE_MAX_COST_UNITS_PER_TASK=100
# Set true to halt the workload administratively. Rule R001 fires first and
# nothing downstream executes.
REAP_GOVERNANCE_KILL_SWITCH_ENGAGED=false

# --- observability ---------------------------------------------------------
REAP_OTEL_SERVICE_NAME=ready-enterprise-ai-platform
# Console span export is noisy; enable it when demonstrating traces locally.
REAP_OTEL_CONSOLE_EXPORTER=false
REAP_OTEL_SAMPLE_RATIO=1.0
REAP_OTEL_REDACTION_ENABLED=true
# Not a secret in the credential sense, but it is an ingestion key: keep it in
# Key Vault and inject it, rather than committing it anywhere.
# REAP_OTEL_APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...

# --- test harness switches -------------------------------------------------
# Integration and load suites are skipped unless explicitly enabled, so `make
# test` never silently requires a subscription.
# REAP_RUN_INTEGRATION=1
# REAP_RUN_LOAD=1
