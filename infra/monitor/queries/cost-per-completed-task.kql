// Cost per completed task — the only unit economics figure that means anything.
//
// Cost per call flatters a system that retries. Cost per token flatters a
// system that answers briefly and wrongly. Cost per *completed task* is the
// number a business can compare against the manual process it replaced.
//
// Prices come from the caller's own rate card. This repository ships no price
// and asserts none; replace the two values below with your negotiated rates.
let price_per_1k_input = 0.0;   // <-- your rate card
let price_per_1k_output = 0.0;  // <-- your rate card
let window = 1d;
let tokens =
    AppMetrics
    | where Name == "Total Tokens"
    | extend CorrelationId = tostring(Properties["CorrelationId"]),
             WorkloadId    = tostring(Properties["WorkloadId"]),
             UserId        = tostring(Properties["UserId"])
    | summarize tokens = sum(Sum) by CorrelationId, WorkloadId, UserId;
let completed =
    AppTraces
    | where Properties.event == "workflow_completed" or Properties.outcome == "completed"
    | extend CorrelationId = tostring(Properties["correlation_id"])
    | distinct CorrelationId;
tokens
| join kind=leftouter completed on CorrelationId
| extend task_completed = isnotempty(CorrelationId1)
| summarize
    total_tokens        = sum(tokens),
    transactions        = dcount(CorrelationId),
    completed_tasks     = dcountif(CorrelationId, task_completed)
    by WorkloadId, bin(now(), window)
// A completion rate below 1.0 is the interesting number: it is the cost of
// work the platform started and did not finish.
| extend completion_rate = round(todouble(completed_tasks) / transactions, 3)
| extend estimated_cost = round(total_tokens / 1000.0 * (price_per_1k_input + price_per_1k_output), 4)
| extend cost_per_completed_task = iff(completed_tasks > 0, round(estimated_cost / completed_tasks, 4), real(null))
| order by cost_per_completed_task desc
